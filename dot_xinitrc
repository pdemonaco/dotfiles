#!/bin/sh
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
xset -b
numlockx &

# give the X display to systemd user units and D-Bus-activated services
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP=i3

# keyring (secrets/pkcs11/gpg); drop ",ssh" if using gcr-ssh-agent
# shellcheck disable=SC2046
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"    # adjust to whichever agent you chose

systemctl --user start i3-session.target
i3
systemctl --user stop i3-session.target
